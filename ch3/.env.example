# Chapter 3 — Ethereum one-hop tracing / trace agent
# Copy to .env; do not commit .env.

# Optional: Etherscan API V2 (without it, public RPC + Blockscout are used)
# ETHERSCAN_API_KEY=your-etherscan-key

# Required only when running ch3_eth_trace_agent.py with --ai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_API_KEY_VF=sk-your-key-here

# Optional model override (default: gpt-5)
# OPENAI_MODEL=gpt-5
